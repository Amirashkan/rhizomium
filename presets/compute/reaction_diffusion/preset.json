          "kind": "ComputeBlur",
          "params": {
            "radius": 3.0,
            "quality": "Medium",
            "direction": "Both"
          }
        },
        "feedback_trail": {
          "kind": "ComputeFeedback",
          "params": {
            "decay": 0.98,
            "scale": 1.002,
            "rotation": 0.5,
            "offsetX": 0.001,
            "offsetY": 0.001
          }
        }
      },
      "connections": [
        {
          "from": "reaction_diffusion.Texture",
          "to": "blur_smooth.Input",
          "description": "Smooth the RD output"
        },
        {
          "from": "blur_smooth.Texture",
          "to": "feedback_trail.Input",
          "description": "Create trailing feedback effect"
        }
      ],
