      "name": "RD + Blur + Feedback Chain",
      "parameterState": {
        "reaction_diffusion": {
          "kind": "ComputeReactionDiffusion",
          "params": {
            "pattern": "Coral",
            "feedRate": 0.0545,
            "killRate": 0.062,
            "diffusionA": 1.0,
            "diffusionB": 0.5,
            "timestep": 1.0,
            "resolution": "512"
          }
