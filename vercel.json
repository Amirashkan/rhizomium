{
  "version": 2,
  "rewrites": [
    {
      "source": "/studio",
      "destination": "/editor/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)\\.(js|css|png|jpg|jpeg|gif|webp|svg|wasm)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/editor",
      "destination": "/studio",
      "permanent": true
    }
  ],
  "cleanUrls": true,
  "trailingSlash": false
}
