node_modules/

# Env files. This repo reads TIER_GRANT_SECRET and OPENAI_API_KEY on the AI
# backend, and `vercel env pull` writes them to .env.local by default -- so
# until now nothing here stopped a deployment's secrets being committed.
.env*
!.env.example
/docs/profiling/
coverage/
test-results/

# Vite build output
dist/

# Tauri / Rust build artifacts
src-tauri/target/
src-tauri/gen/

# Python bytecode cache (the local bridge servers)
__pycache__/

# Generated by `npm run test:performance` (run-performance-tests.js writes
# these to the repository root).
/PERFORMANCE_TEST_REPORT.md
/PERFORMANCE_TEST_REPORT.json
.vercel

# The NDI Runtime staged for the Windows installer by
# scripts/fetch-ndi-runtime.ps1 — Vizrt's files, fetched per build, never
# committed. The notice is ours.
/src-tauri/ndi/*
!/src-tauri/ndi/NDI-NOTICE.txt
