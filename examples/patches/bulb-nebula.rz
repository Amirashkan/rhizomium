    {
      "code": "// Composite, bloom lift, ACES tonemap, vignette, film grain\nlet fr = input1;\nlet q = input3 * 2.0 - vec2<f32>(1.0, 1.0);\nvar col = input0 + vec3<f32>(0.45, 0.75, 1.0) * input2 * 0.6 * (1.0 - fr.w);\ncol = col * (1.0 - fr.w) + fr.xyz;\nlet lum = dot(col, vec3<f32>(0.2126, 0.7152, 0.0722));\ncol = col + col * smoothstep(0.9, 3.0, lum) * 0.35;\ncol = col * 0.9;\ncol = (col * (2.51 * col + 0.03)) / (col * (2.43 * col + 0.59) + 0.14);\nlet vig = smoothstep(1.8, 0.35, length(q * vec2<f32>(0.85, 1.1)));\nlet grain = fract(sin(dot(input3 * g.resolution + g.time, vec2<f32>(12.9898, 78.233))) * 43758.5453) - 0.5;\ncol = pow(clamp(col * vig, vec3<f32>(0.0, 0.0, 0.0), vec3<f32>(1.0, 1.0, 1.0)), vec3<f32>(0.4545, 0.4545, 0.4545)) + grain * 0.025;\ncol\n",
