    {
      "expr": "exp(-a * a * 900.0) * 0.9",
      "id": "15",
      "inputs": [
        {
          "connected": true,
          "from": {
            "nodeId": "13",
            "pin": 0
          },
          "index": 0
        },
        {
          "connected": false,
