    {
      "code": "// Deep-space nebula: warped clouds, dust, ridged filaments and a starfield\nlet w = input0.x;\nlet f = input1.x;\nlet rg = input2.x;\nlet q = input3 * 2.0 - vec2<f32>(1.0, 1.0);\nlet neb = pow(clamp(w * 0.9 + f * 0.5 - 0.38, 0.0, 1.5), 2.1);\nvar col = mix(vec3<f32>(0.01, 0.005, 0.03), vec3<f32>(0.42, 0.03, 0.3), smoothstep(0.0, 0.7, neb));\ncol = mix(col, vec3<f32>(0.0, 0.32, 0.55), smoothstep(0.25, 0.75, f * (1.0 - w)) * 0.9);\ncol = col + vec3<f32>(1.0, 0.55, 0.25) * pow(clamp(rg, 0.0, 1.0), 5.0) * neb * 2.2;\nlet cell = floor(input3 * g.resolution * 0.5);\nlet h = fract(sin(dot(cell, vec2<f32>(12.9898, 78.233))) * 43758.5453);\nlet star = pow(h, 1200.0) * 4.0 * (0.6 + 0.4 * sin(g.time * 3.0 + h * 90.0));\ncol = col * (0.3 + 0.7 * smoothstep(1.7, 0.1, length(q))) + vec3<f32>(star, star * 0.9, star * 1.2);\ncol\n",
