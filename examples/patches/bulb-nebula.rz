      "kind": "CustomGLSL",
      "label": "Mandelbulb",
      "params": {
        "code": "// Raymarched Mandelbulb: orbit-trap colour, fresnel rim, volumetric glow\nlet tm = input1;\nlet pw = input2;\nlet sq = input0 * 2.0 - vec2<f32>(1.0, 1.0);\nlet sp = vec2<f32>(sq.x * g.resolution.x / max(g.resolution.y, 1.0), sq.y);\nlet ang = 0.7 + tm * 0.11;\nlet ro = vec3<f32>(sin(ang) * 2.3, 0.65 + 0.3 * sin(tm * 0.19), cos(ang) * 2.3);\nlet fw = normalize(-ro);\nlet rt = normalize(cross(fw, vec3<f32>(0.0, 1.0, 0.0)));\nlet up = cross(rt, fw);\nlet rd = normalize(sp.x * rt + sp.y * up + 1.7 * fw);\nvar t = 0.0;\nvar hit = 0.0;\nvar glow = 0.0;\nvar trapC = vec3<f32>(1.0, 1.0, 1.0);\nvar steps = 0.0;\nfor (var i = 0; i != 120; i = i + 1) {\n  let pos = ro + rd * t;\n  var z = pos;\n  var dr = 1.0;\n  var r = 0.0;\n  var trap = vec3<f32>(10000.0, 10000.0, 10000.0);\n  for (var k = 0; k != 8; k = k + 1) {\n    r = length(z);\n    if (step(2.0, r) == 1.0) { break; }\n    let th = acos(clamp(z.y / r, -1.0, 1.0)) * pw;\n    let ph = atan2(z.z, z.x) * pw;\n    dr = pow(r, pw - 1.0) * pw * dr + 1.0;\n    let zr = pow(r, pw);\n    z = zr * vec3<f32>(sin(th) * cos(ph), cos(th), sin(th) * sin(ph)) + pos;\n    trap = min(trap, abs(z));\n  }\n  let de = 0.5 * log(max(r, 0.000001)) * r / dr;\n  glow = glow + exp(-de * 30.0) * 0.006;\n  steps = steps + 1.0;\n  if (step(de, 0.0005 * t + 0.0001) == 1.0) { hit = 1.0; trapC = trap; break; }\n  t = t + de * 0.9;\n  if (step(6.0, t) == 1.0) { break; }\n}\nlet hp = ro + rd * t;\nvar nrm = vec3<f32>(0.0, 0.0, 0.0);\nfor (var j = 0; j != 4; j = j + 1) {\n  let ev = vec3<f32>(select(-1.0, 1.0, j == 0 || j == 3), select(-1.0, 1.0, j == 2 || j == 3), select(-1.0, 1.0, j == 1 || j == 3));\n  let qp = hp + ev * 0.0007;\n  var z2 = qp;\n  var dr2 = 1.0;\n  var r2 = 0.0;\n  for (var k2 = 0; k2 != 8; k2 = k2 + 1) {\n    r2 = length(z2);\n    if (step(2.0, r2) == 1.0) { break; }\n    let th2 = acos(clamp(z2.y / r2, -1.0, 1.0)) * pw;\n    let ph2 = atan2(z2.z, z2.x) * pw;\n    dr2 = pow(r2, pw - 1.0) * pw * dr2 + 1.0;\n    z2 = pow(r2, pw) * vec3<f32>(sin(th2) * cos(ph2), cos(th2), sin(th2) * sin(ph2)) + qp;\n  }\n  nrm = nrm + ev * (0.5 * log(max(r2, 0.000001)) * r2 / dr2);\n}\nnrm = normalize(nrm + vec3<f32>(0.000001, 0.000001, 0.000001));\nlet ldir = normalize(vec3<f32>(0.6, 0.75, -0.35));\nlet dif = clamp(dot(nrm, ldir), 0.0, 1.0);\nlet bounce = clamp(0.5 - 0.5 * nrm.y, 0.0, 1.0);\nlet occ = pow(clamp(1.0 - steps / 120.0, 0.0, 1.0), 1.6);\nlet fres = pow(clamp(1.0 + dot(nrm, rd), 0.0, 1.0), 3.0);\nlet spec = pow(clamp(dot(reflect(rd, nrm), ldir), 0.0, 1.0), 40.0);\nlet tc = clamp(trapC, vec3<f32>(0.0, 0.0, 0.0), vec3<f32>(1.0, 1.0, 1.0));\nlet base = 0.5 + 0.5 * cos(6.2831 * (vec3<f32>(0.0, 0.1, 0.2) + tc.x * 0.9 + tc.z * 0.6 + 0.45));\nlet gold = mix(base * base, vec3<f32>(1.0, 0.62, 0.22), smoothstep(0.35, 0.85, tc.y));\nlet surf = gold * (0.03 + 1.8 * dif * occ) * occ + bounce * vec3<f32>(0.25, 0.05, 0.35) * occ * occ + fres * occ * vec3<f32>(0.1, 0.35, 0.8) + spec * occ * vec3<f32>(1.6, 1.3, 1.0);\nlet glowCol = (vec3<f32>(0.15, 0.45, 1.3) * glow + vec3<f32>(1.4, 0.3, 0.8) * glow * glow * 0.8) * (1.0 - hit * 0.7);\nvec4<f32>(surf * hit + glowCol, hit)\n",
        "inputTypes": [
          "vec2",
          "f32",
          "f32",
          "f32"
        ],
        "outputType": "vec4"
      },
